{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-pbxproj.sh",
            "timeout": 5,
            "statusMessage": "Checking project-file guard"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/retro-reminder.sh",
            "timeout": 10,
            "statusMessage": "Checking whether a retrospective is due"
          }
        ]
      }
    ]
  }
}
